{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

{$REMOTE_PI_DDNS_HOSTNAME} {
	tls {
		issuer acme {
			dir {$REMOTE_PI_ACME_DIRECTORY}
			disable_http_challenge
		}
	}

	handle /ws {
		reverse_proxy paseo-relay:4000
	}
	handle /paseo-health {
		rewrite * /health
		reverse_proxy paseo-relay:4000
	}
	handle {
		reverse_proxy relay:3000
	}
}
