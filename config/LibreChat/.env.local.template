# .env.local로 복사한 다음 CHANGE_ME_ 항목을 모두 바꾸세요!
# 기존 설치에서는 암호화 key와 JWT secret을 새 값으로 교체하지 않습니다.
HOST=0.0.0.0
PORT=3080
NODE_ENV=production
CONFIG_PATH=/app/librechat.yaml
MONGO_URI=mongodb://mongodb:27017/LibreChat
# 실제 브라우저 접속 origin으로 두 값을 같게 설정합니다. 예: http://localhost:8588
DOMAIN_CLIENT=CHANGE_ME_PUBLIC_ORIGIN
DOMAIN_SERVER=CHANGE_ME_PUBLIC_ORIGIN
LIBRECHAT_PORT=8588
STRATA_BASE_URL=http://host.docker.internal:8488/v1
# config/Strata/strata.local.json의 api_key와 같은 값을 입력합니다.
STRATA_API_KEY=CHANGE_ME_STRATA_API_KEY
ENDPOINTS=Strata,agents
SEARCH=false
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
# HTTPS origin을 쓰면 true로 바꿉니다.
SESSION_COOKIE_SECURE=false
NO_INDEX=true
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
SCHEDULES_SINGLE_PROCESS=true
NO_PROXY=localhost,127.0.0.1,::1,mongodb,host.docker.internal
LIBRECHAT_TEMP_CREDENTIALS_PATH=/app/data/.env.temp
# CREDS_KEY: 32 random bytes를 표현한 64자리 hex. CREDS_IV: 16 bytes / 32자리 hex.
CREDS_KEY=CHANGE_ME_64_HEX_CHARACTERS
CREDS_IV=CHANGE_ME_32_HEX_CHARACTERS
# 서로 다른 무작위 값을 생성해 넣습니다. 각각 32자 이상이어야 합니다.
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_JWT_REFRESH_SECRET
