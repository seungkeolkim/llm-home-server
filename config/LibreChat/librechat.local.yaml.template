# 이 파일을 librechat.local.yaml로 복사합니다.
# __STRATA_*__ 항목은 prepare-environment.ps1이 Strata 설정을 읽어 확장합니다.
# API key는 .env.local의 STRATA_API_KEY에서 가져옵니다.
version: 1.3.17
cache: true

interface:
  customWelcome: LLM Home Server에서 실행한 model을 선택해 주세요.
  modelSelect: true
  parameters: true
  presets: true
  webSearch: true
  fileSearch: false
  runCode: false
  agents:
    use: true
    create: true
    share: false
    public: false

endpoints:
  allowedAddresses:
    - host.docker.internal:__STRATA_PORT__
  custom:
    - name: Strata
      apiKey: '${STRATA_API_KEY}'
      baseURL: '${STRATA_BASE_URL}'
      models:
        default:
          - __STRATA_MODEL_NAME__
          - qwen3.6-35b-a3b-ud-q4_k_m
        fetch: false
      titleConvo: true
      titleModel: current_model
      modelDisplayLabel: Local LLM
      tokenConfig:
        __STRATA_MODEL_NAME__:
          prompt: 0
          completion: 0
          context: __STRATA_CONTEXT_TOKENS__
        qwen3.6-35b-a3b-ud-q4_k_m:
          prompt: 0
          completion: 0
          context: 153600

modelSpecs:
  list:
    - name: strata-local
      label: Strata · Qwen Flash-Next
      description: Keenable Web Search와 자동 컨텍스트 압축을 사용할 수 있습니다.
      softDefault: true
      preset:
        endpoint: Strata
        model: __STRATA_MODEL_NAME__
        maxContextTokens: __STRATA_CONTEXT_TOKENS__
    - name: polystrata-qwen36
      label: PolyStrata · Qwen3.6 MoE
      description: UD-Q4_K_M · KV Q8_0 · CPU Vision · 150K context
      preset:
        endpoint: Strata
        model: qwen3.6-35b-a3b-ud-q4_k_m
        maxContextTokens: 153600

summarization:
  enabled: true
  provider: Strata
  # model을 생략하면 현재 대화에서 선택한 고정 catalog model을 사용합니다.
  maxSummaryTokens: 4096
  reserveRatio: 0.05
  trigger:
    type: token_ratio
    value: 0.8
  retainRecent:
    turns: 2
    tokens: 4000

webSearch:
  searchProvider: keenable
  scraperProvider: keenable
  rerankerType: none
  keenableSearchOptions:
    maxResults: 5
    attributionTitle: LibreChat
    timeout: 20000
  keenableScraperOptions:
    attributionTitle: LibreChat
    timeout: 20000
